>&#x0A;           &#x20;<pdfaSchema:property
>&#x0A;             &#x20;<rdf:Seq
>&#x0A;               &#x20;<rdf:li pdfaProperty:category="external" pdfaProperty:description="Values for Journal Article Version are one of the following:
AO = Authorâ€™s Original
SMUR = Submitted Manuscript Under Review
AM = Accepted Manuscript
P = Proof
VoR = Version of Record
CVoR = Corrected Version of Record
EVoR = Enhanced Version of Record" pdfaProperty:name="journal_article_version" pdfaProperty:valueType="Closed Choice of Text"
/></rdf:Seq
></pdfaSchema:property
></rdf:Description
